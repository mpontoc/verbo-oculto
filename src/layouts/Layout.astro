---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';
interface Props { title: string; description?: string; canonicalURL?: string; ogImage?: string; }
const { title, description = 'Estudos herméticos, apócrifos e tradição salomônica.', canonicalURL, ogImage } = Astro.props;
const siteURL = 'https://verbooculto.beehiiv.com';
const pageURL = canonicalURL || Astro.url.pathname;
const fullURL = new URL(pageURL, siteURL).href;
const imageURL = ogImage ? new URL(ogImage, siteURL).href : undefined;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullURL} />
    {imageURL && <meta property="og:image" content={imageURL} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Source+Serif+Pro:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono&display=swap" rel="stylesheet" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Verbo Oculto" href="/rss.xml" />
  </head>
  <body>
    <Header />
    <main id="main" role="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>
