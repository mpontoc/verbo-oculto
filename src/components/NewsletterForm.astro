---
interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
}
const { title = 'Receba o Verbo na sua caixa de entrada', description = 'Newsletter semanal com traduções comentadas, chaves de leitura e prática hermética. Grátis. Sem spam.', buttonText = 'Quero receber' } = Astro.props;
---
<section class="newsletter-section" aria-labelledby="newsletter-title">
  <div class="container" style="text-align: center;">
    <h2 id="newsletter-title">{title}</h2>
    <p>{description}</p>
    <form class="newsletter-form" action="https://verbooculto.beehiiv.com/subscribe" method="POST" target="_blank">
      <input type="hidden" name="referral" value="site-verbo-oculto" />
      <label for="email" class="visually-hidden">Seu melhor email</label>
      <input type="email" id="email" name="email" placeholder="seu@email.com" required autocomplete="email" />
      <button type="submit">{buttonText}</button>
    </form>
    <p style="font-size: .8rem; color: rgba(255,255,255,.6); margin-top: 1rem;">Ao assinar, você concorda com nossa <a href="/privacidade" style="color: var(--color-accent);">Política de Privacidade</a>. Pode cancelar a qualquer momento.</p>
  </div>
</section>
