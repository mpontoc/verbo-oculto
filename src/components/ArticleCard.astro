---
interface Props {
  post: import('astro:content').CollectionEntry<'post'>;
}
const { post } = Astro.props;
const postUrl = `/artigos/${post.slug}/`;
const categoryLabels: Record<string, string> = {
  hermetismo: 'Hermetismo',
  apocrifos: 'Apócrifos',
  salomao: 'Tradição Salomônica',
  gnose: 'Gnose',
  pratica: 'Prática',
  guias: 'Guias',
};
---
<article class="article-card">
  {post.data.heroImage && (
    <a href={postUrl} aria-label={`Ler: ${post.data.title}`}>
      <img src={post.data.heroImage} alt={post.data.heroAlt || post.data.title} loading="lazy" />
    </a>
  )}
  <div class="article-card-content">
    <span class="category">{categoryLabels[post.data.category] || post.data.category}</span>
    <h2><a href={postUrl}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <div class="meta">
      <time datetime={post.data.pubDate.toISOString().split('T')[0]}>{post.data.pubDate.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
      <span>{post.data.schema?.timeRequired || 'Leitura rápida'}</span>
    </div>
  </div>
</article>
