---
const base = import.meta.env.BASE_URL || '/';
const navLinks = [
  { href: base, label: 'Início' },
  { href: `${base}artigos/`, label: 'Artigos' },
  { href: `${base}categorias/hermetismo`, label: 'Hermetismo' },
  { href: `${base}categorias/apocrifos`, label: 'Apócrifos' },
  { href: `${base}categorias/salomao`, label: 'Salomão' },
  { href: `${base}categorias/gnose`, label: 'Gnose' },
  { href: `${base}recursos`, label: 'Recursos' },
  { href: `${base}newsletter`, label: 'Newsletter' },
];
---
<header class="site-header" role="banner">
  <a href="#main" class="skip-link">Pular para o conteúdo principal</a>
  <div class="container header-inner">
    <a href={base} class="site-title" aria-label="Verbo Oculto — Início">Verbo Oculto</a>
    <nav class="nav" aria-label="Navegação principal">
      {navLinks.map(link => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
  </div>
</header>
